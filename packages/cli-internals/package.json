{
  "name": "@projitect/cli-internals",
  "version": "1.0.1",
  "description": "Engine for the projitect CLI — loader, planner, differ, applier, and command dispatchers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projitect/projitect.git",
    "directory": "packages/cli-internals"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser-blueprints": {
      "types": "./dist/browser-blueprints.d.ts",
      "import": "./dist/browser-blueprints.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "tc": "tsc --build"
  },
  "dependencies": {
    "@nunofyobiz/effect-extras": "3.2.0",
    "cross-spawn": "7.0.6",
    "sucrase": "3.35.1",
    "which": "7.0.0"
  },
  "devDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/blueprint-changesets": "workspace:*",
    "@projitect/blueprint-gitignore": "workspace:*",
    "@projitect/blueprint-husky-lint-staged": "workspace:*",
    "@projitect/blueprint-markdown": "workspace:*",
    "@projitect/blueprint-next": "workspace:*",
    "@projitect/blueprint-react": "workspace:*",
    "@projitect/blueprint-skills": "workspace:*",
    "@projitect/blueprint-tsconfig": "workspace:*",
    "@projitect/blueprint-vitest": "workspace:*",
    "@projitect/core": "workspace:*",
    "@projitect/test-kit": "workspace:*",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.19",
    "@types/which": "3.0.4",
    "effect": "4.0.0-rc.111",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/blueprint-changesets": "workspace:*",
    "@projitect/blueprint-gitignore": "workspace:*",
    "@projitect/blueprint-husky-lint-staged": "workspace:*",
    "@projitect/blueprint-markdown": "workspace:*",
    "@projitect/blueprint-next": "workspace:*",
    "@projitect/blueprint-react": "workspace:*",
    "@projitect/blueprint-skills": "workspace:*",
    "@projitect/blueprint-tsconfig": "workspace:*",
    "@projitect/blueprint-vitest": "workspace:*",
    "@projitect/core": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "peerDependenciesMeta": {
    "@projitect/blueprint-changesets": {
      "optional": true
    },
    "@projitect/blueprint-gitignore": {
      "optional": true
    },
    "@projitect/blueprint-husky-lint-staged": {
      "optional": true
    },
    "@projitect/blueprint-markdown": {
      "optional": true
    },
    "@projitect/blueprint-next": {
      "optional": true
    },
    "@projitect/blueprint-react": {
      "optional": true
    },
    "@projitect/blueprint-skills": {
      "optional": true
    },
    "@projitect/blueprint-tsconfig": {
      "optional": true
    },
    "@projitect/blueprint-vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
