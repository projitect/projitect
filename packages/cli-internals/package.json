{
  "name": "@projitect/cli-internals",
  "version": "1.0.0",
  "description": "Engine for the projitect CLI — loader, planner, differ, applier, and command dispatchers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projitect/projitect.git",
    "directory": "packages/cli-internals"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "tc": "tsc --build"
  },
  "dependencies": {
    "@nunofyobiz/effect-extras": "3.2.0",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/blueprint-gitignore": "workspace:*",
    "@projitect/blueprint-markdown": "workspace:*",
    "@projitect/blueprint-next": "workspace:*",
    "@projitect/blueprint-react": "workspace:*",
    "@projitect/core": "workspace:*",
    "@projitect/test-kit": "workspace:*",
    "@types/node": "22.19.19",
    "effect": "4.0.0-rc.111",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/core": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
