{
  "name": "@projitect/blueprint-markdown",
  "version": "1.0.1",
  "description": "Composable AGENTS.md and README.md snippets (package manager, verification, commits, license, ...) for projitect.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projitect/projitect.git",
    "directory": "packages/blueprint-markdown"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "tc": "tsc --build"
  },
  "devDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/core": "workspace:*",
    "@projitect/test-kit": "workspace:*",
    "effect": "4.0.0-rc.111",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/core": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "projitect": {
    "type": "blueprint-set",
    "import": "import { markdownSnippets } from \"@projitect/blueprint-markdown\"",
    "callTemplate": "markdownSnippets.{section}()",
    "sections": [
      "agentsPackageManager",
      "agentsVerification",
      "agentsCommits",
      "agentsNoDestructiveShortcuts",
      "readmeContributing",
      "readmeLicense"
    ]
  }
}
