{
  "name": "@projitect/blueprint-gitignore",
  "version": "1.0.0",
  "description": "Composable .gitignore sections (macOS, Windows, Linux, Node, Next.js, VS Code, JetBrains, tsbuildinfo, Vite, Astro, Nuxt, SvelteKit, Angular, Vue, Storybook, Yarn, pnpm, Vim, Sublime Text, Eclipse) for projitect.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projitect/projitect.git",
    "directory": "packages/blueprint-gitignore"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "tc": "tsc --build"
  },
  "devDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/core": "workspace:*",
    "@projitect/test-kit": "workspace:*",
    "effect": "4.0.0-rc.111",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@projitect/blueprint": "workspace:*",
    "@projitect/core": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "projitect": {
    "type": "blueprint-set",
    "import": "import { gitignores } from \"@projitect/blueprint-gitignore\"",
    "callTemplate": "gitignores.{section}()",
    "sections": [
      "macOs",
      "windows",
      "linux",
      "node",
      "next",
      "vscode",
      "jetbrains",
      "tsbuildinfo",
      "vite",
      "astro",
      "nuxt",
      "svelteKit",
      "angular",
      "vue",
      "storybook",
      "yarn",
      "pnpm",
      "vim",
      "sublimeText",
      "eclipse"
    ]
  }
}
